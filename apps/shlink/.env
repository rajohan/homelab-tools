DEFAULT_DOMAIN="go.rajohan.no"
IS_HTTPS_ENABLED="true"
TIMEZONE="Europe/Oslo"
INITIAL_API_KEY="${HOMELAB_TOOLS_SHLINK_API_KEY:?Load the Doppler environment first}"
DB_DRIVER="postgres"
DB_HOST="db.home.rajohan.no"
DB_PORT="6432"
DB_NAME="shlink"
DB_USER="shlink_app"
DB_PASSWORD="${HOMELAB_TOOLS_DB_SHLINK_PASSWORD:?Load the Doppler environment first}"
DB_USE_ENCRYPTION="true"
TRUSTED_PROXIES="10.77.50.2"
WEB_WORKER_NUM="2"
TASK_WORKER_NUM="1"
MEMORY_LIMIT="256M"
LOGS_FORMAT="json"
AUTO_RESOLVE_TITLES="false"
TRACK_ORPHAN_VISITS="false"
ANONYMIZE_REMOTE_ADDR="true"
CORS_ALLOW_ORIGIN="https://links.home.rajohan.no"
CORS_ALLOW_CREDENTIALS="true"
REDIS_SERVERS="tcp://:${HOMELAB_TOOLS_VALKEY_PASSWORD_URIENCODED:?Load the Doppler environment first}@valkey-shlink:6379/0"
